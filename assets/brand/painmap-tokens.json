{
  "meta": {
    "name": "PainMap Evidence Contours",
    "version": "1.0.0",
    "date": "2026-07-14"
  },
  "color": {
    "paper": "#F2EFE7",
    "ink": "#171A1B",
    "deep_teal": "#174D55",
    "signal_coral": "#E65B43",
    "signal_dark": "#B83E2C",
    "mist": "#DCE8E3",
    "stone": "#626A6A",
    "chalk": "#FFFFFF",
    "line": "#C7CBC5",
    "direct": "#174D55",
    "modeled": "#5367A8",
    "proxy": "#8A5A12",
    "priority": "#B83E2C",
    "boundary": "#7F8988",
    "nodata": "#E1DFD8"
  },
  "typography": {
    "display": {
      "family": "Noto Serif Display",
      "fallback": ["Georgia", "serif"]
    },
    "interface": {
      "family": "Inter",
      "fallback": ["Arial", "sans-serif"]
    },
    "metadata": {
      "family": "PT Mono",
      "fallback": ["Courier New", "monospace"]
    }
  },
  "spacing_px": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "radius_px": {
    "panel": 0,
    "control": 4
  },
  "grid": {
    "desktop_columns": 12,
    "tablet_columns": 6,
    "mobile_columns": 4,
    "max_width_px": 1440,
    "gutter_px": 24
  },
  "evidence_strokes": {
    "direct": { "dasharray": null, "color": "#174D55" },
    "modeled": { "dasharray": "30 18", "color": "#5367A8" },
    "proxy": { "dasharray": "2 17 28 17", "color": "#8A5A12" },
    "priority": { "pattern": "45deg hatch", "color": "#B83E2C" },
    "boundary": { "width": 1, "color": "#7F8988" }
  }
}
