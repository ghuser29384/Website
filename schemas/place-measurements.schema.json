{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://painmap.org/schemas/place-measurements.schema.json",
  "title": "PainMap place measurements",
  "type": "object",
  "required": [
    "build",
    "measurements"
  ],
  "properties": {
    "build": {
      "type": "object"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "measurement_id",
          "release_id",
          "place_id",
          "place_name",
          "geometry_level",
          "layer_id",
          "evidence_kind",
          "raw_value",
          "display_value",
          "source_ids",
          "confidence_low",
          "confidence_high",
          "uncertainty_class",
          "license_id"
        ]
      }
    }
  }
}
